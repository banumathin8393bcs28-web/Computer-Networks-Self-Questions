            strcpy(request, "EXIT");
            send_line(sock, request);
            if (recv_line(sock, response, sizeof(response)))
                printf("%s\n", response);
            close(sock);
            return 0;

        default:
            printf("Choose a number from 1 to 6.\n");
            continue;
