#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8090
#define SIZE 2048
#define MAX_BOOKINGS 200

typedef struct {
    int id;
    char name[40];
    char source[30];
    char destination[30];
    int seats;
    int fare;
} Train;

typedef struct {
    int booking_id;
    int train_id;
    int seats;
    int active;
    char passenger[40];
} Booking;

Train trains[] = {
    {101, "ChennaiExpress", "Chennai", "Madurai", 50, 250},
    {102, "PandianExpress", "Chennai", "Ramanathapuram", 40, 300},
    {103, "VaigaiExpress", "Chennai", "Trichy", 30, 200}
};

int train_count = 3;
Booking bookings[MAX_BOOKINGS];
int booking_count = 0;
int next_booking_id = 1001;

int send_line(int fd, const char *msg)
{
    char out[SIZE];
    int len = snprintf(out, sizeof(out), "%s\n", msg);

    if (len < 0 || len >= SIZE)
        return -1;

    int sent = 0;

    while (sent < len) {
        ssize_t n = send(fd, out + sent, len - sent, 0);

        if (n <= 0)
            return -1;

        sent += (int)n;
    }

    return 0;
}

int recv_line(int fd, char *buffer, size_t size)
{
    size_t i = 0;
    char ch;

    while (i < size - 1) {
        ssize_t n = recv(fd, &ch, 1, 0);

        if (n <= 0)
            return 0;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buffer[i++] = ch;
    }

    buffer[i] = '\0';
    return 1;
}

void log_event(const char *event)
{
    FILE *fp = fopen("railway_log.txt", "a");
    time_t now = time(NULL);
    struct tm *tm_info = localtime(&now);
    char timestamp[30] = "unknown-time";

    if (tm_info != NULL) {
        strftime(timestamp, sizeof(timestamp),
                 "%Y-%m-%d %H:%M:%S", tm_info);
    }

    printf("[%s] %s\n", timestamp, event);

    if (fp != NULL) {
        fprintf(fp, "[%s] %s\n", timestamp, event);
        fclose(fp);
    }
}

int find_train(int id)
{
    for (int i = 0; i < train_count; i++) {
        if (trains[i].id == id)
            return i;
    }

    return -1;
}

int available_seats(int train_id)
{
    int index = find_train(train_id);

    if (index < 0)
        return -1;

    int booked = 0;

    for (int i = 0; i < booking_count; i++) {
        if (bookings[i].train_id == train_id &&
            bookings[i].active) {
            booked += bookings[i].seats;
        }
    }

    return trains[index].seats - booked;
}

int save_bookings(void)
{
    FILE *fp = fopen("railway_bookings.txt", "w");

    if (fp == NULL) {
        perror("railway_bookings.txt");
        return 0;
    }

    for (int i = 0; i < booking_count; i++) {
        fprintf(fp, "%d %d %d %d %s\n",
                bookings[i].booking_id,
                bookings[i].train_id,
                bookings[i].seats,
                bookings[i].active,
                bookings[i].passenger);
    }

    fclose(fp);
    return 1;
}

void load_bookings(void)
{
    FILE *fp = fopen("railway_bookings.txt", "r");

    if (fp == NULL)
        return;

    while (booking_count < MAX_BOOKINGS &&
           fscanf(fp, "%d %d %d %d %39s",
                  &bookings[booking_count].booking_id,
                  &bookings[booking_count].train_id,
                  &bookings[booking_count].seats,
                  &bookings[booking_count].active,
                  bookings[booking_count].passenger) == 5) {

        if (bookings[booking_count].booking_id >= next_booking_id)
            next_booking_id =
                bookings[booking_count].booking_id + 1;

        booking_count++;
    }

    fclose(fp);
}

void search_trains(int fd)
{
    char response[SIZE] = "";

    for (int i = 0; i < train_count; i++) {
        char item[200];

        int len = snprintf(item, sizeof(item),
            "%d %s %s-%s Fare=%d Available=%d; ",
            trains[i].id,
            trains[i].name,
            trains[i].source,
            trains[i].destination,
            trains[i].fare,
            available_seats(trains[i].id));

        if (len < 0 || (size_t)len >= sizeof(item))
            continue;

        size_t used = strlen(response);
        size_t remaining = sizeof(response) - used - 1;

        if ((size_t)len > remaining)
            break;

        memcpy(response + used, item, (size_t)len + 1);
    }

    send_line(fd, response);
}

void process_request(int fd, char *request)
{
    char response[SIZE];
    int id, seats;

    if (strcmp(request, "SEARCH") == 0) {
        search_trains(fd);
        log_event("Train search performed");
    }
    else if (strncmp(request, "AVAIL|", 6) == 0 &&
             sscanf(request + 6, "%d", &id) == 1) {

        int index = find_train(id);

        if (index < 0) {
            send_line(fd, "ERROR: Train not found.");
        } else {
            snprintf(response, sizeof(response),
                "%s: Available seats=%d Fare=%d",
                trains[index].name,
                available_seats(id),
                trains[index].fare);

            send_line(fd, response);
        }
    }
    else if (strncmp(request, "BOOK|", 5) == 0) {
        int train_id;
        char passenger[40];

        if (sscanf(request, "BOOK|%d|%39[^|]|%d",
                   &train_id, passenger, &seats) != 3 ||
            seats <= 0 || strchr(passenger, ' ')) {
            send_line(fd, "ERROR: Invalid booking details.");
            return;
        }

        int index = find_train(train_id);

        if (index < 0) {
            send_line(fd, "ERROR: Train not found.");
            return;
        }

        if (seats > available_seats(train_id)) {
            send_line(fd, "ERROR: Not enough seats available.");
            return;
        }

        if (booking_count >= MAX_BOOKINGS) {
            send_line(fd, "ERROR: Booking database is full.");
            return;
        }

        Booking b;
        b.booking_id = next_booking_id++;
        b.train_id = train_id;
        b.seats = seats;
        b.active = 1;

        snprintf(b.passenger, sizeof(b.passenger),
                 "%s", passenger);

        bookings[booking_count++] = b;

        if (!save_bookings()) {
            booking_count--;
            next_booking_id--;
            send_line(fd, "ERROR: Could not save booking.");
            return;
        }

        snprintf(response, sizeof(response),
            "BOOKED: BookingID=%d Train=%s Passenger=%s Seats=%d TotalFare=%d",
            b.booking_id,
            trains[index].name,
            b.passenger,
            b.seats,
            b.seats * trains[index].fare);

        send_line(fd, response);
        log_event(response);
    }
    else if (strncmp(request, "CANCEL|", 7) == 0 &&
             sscanf(request + 7, "%d", &id) == 1) {

        int found = -1;

        for (int i = 0; i < booking_count; i++) {
            if (bookings[i].booking_id == id &&
                bookings[i].active) {
                found = i;
                break;
            }
        }

        if (found < 0) {
            send_line(fd, "ERROR: Active booking not found.");
        } else {
            bookings[found].active = 0;

            if (!save_bookings()) {
                bookings[found].active = 1;
                send_line(fd, "ERROR: Could not save cancellation.");
                return;
            }

            snprintf(response, sizeof(response),
                     "CANCELLED: BookingID=%d", id);

            send_line(fd, response);
            log_event(response);
        }
    }
    else if (strncmp(request, "STATUS|", 7) == 0 &&
             sscanf(request + 7, "%d", &id) == 1) {

        int found = -1;

        for (int i = 0; i < booking_count; i++) {
            if (bookings[i].booking_id == id) {
                found = i;
                break;
            }
        }

        if (found < 0) {
            send_line(fd, "ERROR: Booking not found.");
        } else {
            Booking *b = &bookings[found];
            int index = find_train(b->train_id);

            snprintf(response, sizeof(response),
                "BookingID=%d Passenger=%s Train=%s Seats=%d Status=%s",
                b->booking_id,
                b->passenger,
                index >= 0 ? trains[index].name : "Unknown",
                b->seats,
                b->active ? "CONFIRMED" : "CANCELLED");

            send_line(fd, response);
        }
    }
    else if (strcmp(request, "EXIT") == 0) {
        send_line(fd, "Goodbye.");
    }
    else {
        send_line(fd, "ERROR: Invalid request.");
        log_event("Invalid client request");
    }
}

int main(void)
{
    int server_fd, client_fd, opt = 1;
    struct sockaddr_in address;

    load_bookings();

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&address, 0, sizeof(address));
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&address,
             sizeof(address)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, 5) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Railway Reservation Server running on port %d\n", PORT);

    while (1) {
        printf("Waiting for a client...\n");

        client_fd = accept(server_fd, NULL, NULL);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        printf("Client connected.\n");

        char request[SIZE];

        while (recv_line(client_fd, request, sizeof(request))) {
            process_request(client_fd, request);

            if (strcmp(request, "EXIT") == 0)
                break;
        }

        close(client_fd);
        log_event("Client disconnected");
    }

    close(server_fd);
    return 0;
}


