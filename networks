            break;

        input[strcspn(input, "\r\n")] = '\0';

        if (send(sock, input, strlen(input), 0) < 0)
            break;

        if (strcmp(input, "/exit") == 0)
            break;
    }

    shutdown(sock, SHUT_RDWR);
    close(sock);
