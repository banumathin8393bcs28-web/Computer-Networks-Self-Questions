        if (books[i].id == id)
            return i;

    return -1;
}

void process_request(const char *request,
                     char *response, size_t size)
{
    int id;
    char title[50];

    if (strcmp(request, "LIST") == 0) {
        size_t used = 0;

        for (int i = 0; i < MAX_BOOKS; i++) {
            int n = snprintf(response + used, size - used,
                "ID=%d Title=%s Author=%s Status=%s\n",
                books[i].id, books[i].title, books[i].author,
                books[i].available ? "Available" : "Issued");

            if (n < 0 || (size_t)n >= size - used)
                break;

            used += (size_t)n;
        }
    }
    else if (sscanf(request, "SEARCH %49s", title) == 1) {
        int found = 0;

        for (int i = 0; i < MAX_BOOKS; i++) {
            if (strcasestr(books[i].title, title) ||
                strcasestr(books[i].author, title)) {
                snprintf(response, size,
                    "ID=%d Title=%s Author=%s Status=%s",
                    books[i].id, books[i].title, books[i].author,
                    books[i].available ? "Available" : "Issued");
                found = 1;
                break;
            }
        }

        if (!found)
            snprintf(response, size, "ERROR: Book not found.");
    }
    else if (sscanf(request, "ISSUE %d", &id) == 1) {
        int index = find_book(id);

        if (index < 0)
            snprintf(response, size, "ERROR: Invalid book ID.");
        else if (!books[index].available)
            snprintf(response, size, "ERROR: Book already issued.");
        else {
            books[index].available = 0;
            save_books();
            snprintf(response, size, "SUCCESS: %s issued.", books[index].title);
        }
    }
    else if (sscanf(request, "RETURN %d", &id) == 1) {
        int index = find_book(id);

        if (index < 0)
            snprintf(response, size, "ERROR: Invalid book ID.");
        else if (books[index].available)
            snprintf(response, size, "ERROR: Book is not issued.");
        else {
            books[index].available = 1;
            save_books();
            snprintf(response, size, "SUCCESS: %s returned.", books[index].title);
        }
    }
    else {
        snprintf(response, size,
                 "ERROR: Invalid request. Use LIST, SEARCH, ISSUE, RETURN.");
    }
}

