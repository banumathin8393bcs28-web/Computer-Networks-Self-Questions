    if (send(sock, input, strlen(input), 0) < 0) {
        perror("send");
        close(sock);
        return 1;
    }

    if (pthread_create(&receiver, NULL,
                       receive_messages, NULL) != 0) {
        perror("pthread_create");
        close(sock);
        return 1;
    }

