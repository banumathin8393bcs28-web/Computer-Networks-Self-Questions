    struct sockaddr_in server;
    struct timeval timeout = {2, 0};
    socklen_t server_len = sizeof(server);
    char request[SIZE], response[SIZE], term[50];

    sock = socket(AF_INET, SOCK_DGRAM, 0);
    if (sock < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO,
               &timeout, sizeof(timeout));

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server.sin_addr);

    while (1) {
        printf("\n===== UDP LIBRARY MANAGEMENT =====\n");
        printf("1. List all books\n");
        printf("2. Search book\n");
        printf("3. Issue book\n");
        printf("4. Return book\n");
        printf("5. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            int ch;
            while ((ch = getchar()) != '\n' && ch != EOF) {}
            printf("Invalid input.\n");
            continue;
        }

        if (choice == 1)
            snprintf(request, sizeof(request), "Q1 LIST");
        else if (choice == 2) {
            printf("Enter title/author (one word): ");
            scanf("%49s", term);
            snprintf(request, sizeof(request), "Q1 SEARCH %s", term);
        }
        else if (choice == 3) {
            printf("Enter book ID: ");
            if (scanf("%d", &id) != 1) {
                printf("Invalid ID.\n");
                return 1;
            }
            snprintf(request, sizeof(request), "Q1 ISSUE %d", id);
        }
        else if (choice == 4) {
            printf("Enter book ID: ");
            if (scanf("%d", &id) != 1) {
                printf("Invalid ID.\n");
                return 1;
            }
            snprintf(request, sizeof(request), "Q1 RETURN %d", id);
        }
        else if (choice == 5) {
            printf("Client terminated.\n");
            break;
        }
        else {
            printf("Choose 1 to 5.\n");
            continue;
        }

        int received = 0;

        for (int attempt = 1; attempt <= MAX_RETRIES; attempt++) {
            printf("Sending request (attempt %d)...\n", attempt);

            if (sendto(sock, request, strlen(request), 0,
                       (struct sockaddr *)&server,
                       sizeof(server)) < 0) {
                perror("sendto");
                break;
            }

            ssize_t n = recvfrom(sock, response, sizeof(response) - 1,
                                 0, (struct sockaddr *)&server,
                                 &server_len);

            if (n >= 0) {
                response[n] = '\0';
                printf("Server ACK/response:\n%s\n", response);
                received = 1;
                break;
            }

            printf("Timeout: no response received.\n");
        }

        if (!received)
            printf("Server did not respond after %d attempts.\n",
                   MAX_RETRIES);
    }

    close(sock);
    return 0;
}


