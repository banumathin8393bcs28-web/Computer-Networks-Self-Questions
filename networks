#include <ctype.h>
#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <arpa/inet.h>
#include <time.h>
#include <sys/socket.h>

#define PORT 8086
#define MAX_CLIENTS 10
#define BUFFER_SIZE 2048

pthread_mutex_t log_mutex = PTHREAD_MUTEX_INITIALIZER;
pthread_mutex_t data_mutex = PTHREAD_MUTEX_INITIALIZER;

typedef struct {
    int socket;
    char username[50];
} Student;

typedef struct {
    char question[200];
    char options[4][100];
    char answer;
} Question;

Question questions[] = {
    {"Which language is used for system programming?",
     {"A. HTML", "B. C", "C. CSS", "D. XML"}, 'B'},

    {"Which protocol is connection-oriented?",
     {"A. UDP", "B. IP", "C. TCP", "D. ARP"}, 'C'},

    {"Which function creates a thread in POSIX?",
     {"A. pthread_create", "B. fork", "C. socket", "D. accept"}, 'A'}
};

#define TOTAL_QUESTIONS (sizeof(questions) / sizeof(questions[0]))

void log_activity(const char *message)
{
    time_t now = time(NULL);
    char timestamp[30];

    strftime(timestamp, sizeof(timestamp),
             "%Y-%m-%d %H:%M:%S", localtime(&now));

    pthread_mutex_lock(&log_mutex);
    FILE *fp = fopen("exam_log.txt", "a");

    if (fp != NULL) {
        fprintf(fp, "[%s] %s\n", timestamp, message);
        fclose(fp);
    }

    printf("[%s] %s\n", timestamp, message);
    pthread_mutex_unlock(&log_mutex);
}

int send_text(int sock, const char *message)
{
    return send(sock, message, strlen(message), 0);
}

int receive_text(int sock, char *buffer, size_t size)
{
    ssize_t n = recv(sock, buffer, size - 1, 0);

    if (n <= 0)
        return 0;

    buffer[n] = '\0';

    buffer[strcspn(buffer, "\r\n")] = '\0';
    return 1;
}

void *handle_student(void *arg)
{
    Student *student = (Student *)arg;
    int sock = student->socket;
    char username[50];
    char password[50];
    char buffer[BUFFER_SIZE];
    char logmsg[200];
    int score = 0;
    int authenticated = 0;

    snprintf(logmsg, sizeof(logmsg),
             "Client connected: socket %d", sock);
    log_activity(logmsg);

    send_text(sock, "=== ONLINE EXAMINATION SYSTEM ===\n");
    send_text(sock, "Username: ");

    if (!receive_text(sock, username, sizeof(username)))
        goto cleanup;

    send_text(sock, "Password: ");

    if (!receive_text(sock, password, sizeof(password)))
        goto cleanup;

    /*
       Sample credentials:
       student1 / pass123
       student2 / pass456
    */
    if ((strcmp(username, "student1") == 0 &&
         strcmp(password, "pass123") == 0) ||
        (strcmp(username, "student2") == 0 &&
         strcmp(password, "pass456") == 0)) {
        authenticated = 1;
    }

    if (!authenticated) {
        send_text(sock, "Invalid username or password.\n");
        snprintf(logmsg, sizeof(logmsg),
                 "Authentication failed for %s", username);
        log_activity(logmsg);
        goto cleanup;
    }

    snprintf(student->username, sizeof(student->username),
             "%s", username);

    snprintf(logmsg, sizeof(logmsg),
             "Student %s logged in successfully", username);
    log_activity(logmsg);

    send_text(sock,
        "\nLogin successful!\n"
        "Commands: EXAM, SCORE, EXIT\n");

    while (1) {
        send_text(sock, "\nEnter command: ");

        if (!receive_text(sock, buffer, sizeof(buffer)))
            break;

        if (strcasecmp(buffer, "EXAM") == 0) {
            score = 0;

            for (int i = 0; i < TOTAL_QUESTIONS; i++) {
                char question_text[700];

                snprintf(question_text, sizeof(question_text),
                    "\nQuestion %d: %s\n%s\n%s\n%s\n%s\nYour answer (A/B/C/D): ",
                    i + 1,
                    questions[i].question,
                    questions[i].options[0],
                    questions[i].options[1],
                    questions[i].options[2],
                    questions[i].options[3]);

                if (send_text(sock, question_text) < 0)
                    goto cleanup;

                if (!receive_text(sock, buffer, sizeof(buffer)))
                    goto cleanup;

                if (toupper((unsigned char)buffer[0]) ==
                    questions[i].answer) {
                    score++;
                }
            }

            pthread_mutex_lock(&data_mutex);
            snprintf(logmsg, sizeof(logmsg),
                     "Exam submitted by %s, score %d/%zu",
                     username, score, TOTAL_QUESTIONS);
            pthread_mutex_unlock(&data_mutex);

            log_activity(logmsg);

            snprintf(buffer, sizeof(buffer),
                "\nExam completed! Your score: %d/%zu\n",
                score, TOTAL_QUESTIONS);
            send_text(sock, buffer);
        }
        else if (strcasecmp(buffer, "SCORE") == 0) {
            snprintf(buffer, sizeof(buffer),
                "Latest score: %d/%zu\n", score, TOTAL_QUESTIONS);
            send_text(sock, buffer);
        }
        else if (strcasecmp(buffer, "EXIT") == 0) {
            send_text(sock, "You have logged out.\n");
            break;
        }
        else {
            send_text(sock,
                "Invalid command. Use EXAM, SCORE, or EXIT.\n");
            log_activity("Invalid client command received");
        }
    }

cleanup:
    snprintf(logmsg, sizeof(logmsg),
             "Client disconnected: socket %d", sock);
    log_activity(logmsg);

    close(sock);
    free(student);
    return NULL;
}

int main(void)
{
    int server_fd;
    int client_fd;
    int opt = 1;
    struct sockaddr_in server_addr, client_addr;
    socklen_t client_len = sizeof(client_addr);

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, MAX_CLIENTS) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Exam server running on port %d...\n", PORT);
    printf("Waiting for students...\n");

    while (1) {
        client_fd = accept(server_fd,
            (struct sockaddr *)&client_addr, &client_len);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        Student *student = calloc(1, sizeof(Student));

        if (student == NULL) {
            close(client_fd);
            continue;
        }

        student->socket = client_fd;

        pthread_t thread;

        if (pthread_create(&thread, NULL,
                           handle_student, student) != 0) {
            perror("pthread_create");
            close(client_fd);
            free(student);
            continue;
        }

        pthread_detach(thread);
    }

    close(server_fd);
    return 0;
}



#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <time.h>

#define PORT 8087
#define MAX_CLIENTS 20
#define BUFFER_SIZE 1024

int clients[MAX_CLIENTS];
char names[MAX_CLIENTS][50];
int client_count = 0;

pthread_mutex_t clients_mutex = PTHREAD_MUTEX_INITIALIZER;

void broadcast_message(const char *message, int sender)
{
    pthread_mutex_lock(&clients_mutex);

    for (int i = 0; i < client_count; i++) {
        if (clients[i] != sender) {
            if (send(clients[i], message, strlen(message), 0) < 0) {
                perror("send");
            }
        }
    }

    pthread_mutex_unlock(&clients_mutex);
}

void remove_client(int sock)
{
    pthread_mutex_lock(&clients_mutex);

    for (int i = 0; i < client_count; i++) {
        if (clients[i] == sock) {
            for (int j = i; j < client_count - 1; j++) {
                clients[j] = clients[j + 1];
                strcpy(names[j], names[j + 1]);
            }

            client_count--;
            break;
        }
    }

    pthread_mutex_unlock(&clients_mutex);
}

void *handle_client(void *arg)
{
    int sock = *(int *)arg;
    free(arg);

    char buffer[BUFFER_SIZE];
    char username[50];
    char message[BUFFER_SIZE + 100];
    char timestamp[30];
    time_t now;

    send(sock, "Enter your username: ", 21, 0);

    ssize_t n = recv(sock, username, sizeof(username) - 1, 0);

    if (n <= 0)
        goto disconnect;

    username[n] = '\0';
    username[strcspn(username, "\r\n")] = '\0';

    if (strlen(username) == 0)
        snprintf(username, sizeof(username), "Guest");

    pthread_mutex_lock(&clients_mutex);

    if (client_count >= MAX_CLIENTS) {
        pthread_mutex_unlock(&clients_mutex);
        send(sock, "Server is full.\n", 16, 0);
        goto disconnect;
    }

    clients[client_count] = sock;
    snprintf(names[client_count], sizeof(names[client_count]),
             "%s", username);
    client_count++;

    pthread_mutex_unlock(&clients_mutex);

    snprintf(message, sizeof(message),
             "*** %s joined the chat ***\n", username);

    printf("%s", message);
    broadcast_message(message, sock);

    send(sock,
         "Welcome! Type messages to chat. Type /exit to leave.\n",
         53, 0);

    while (1) {
        n = recv(sock, buffer, sizeof(buffer) - 1, 0);

        if (n <= 0)
            break;

        buffer[n] = '\0';
        buffer[strcspn(buffer, "\r\n")] = '\0';

        if (strcmp(buffer, "/exit") == 0)
            break;

        if (strlen(buffer) == 0)
            continue;

        now = time(NULL);
        struct tm *tm_info = localtime(&now);

        strftime(timestamp, sizeof(timestamp),
                 "%H:%M:%S", tm_info);

        snprintf(message, sizeof(message),
                 "[%s] %s: %s\n", timestamp, username, buffer);

        printf("%s", message);
        broadcast_message(message, sock);
    }

disconnect:
    remove_client(sock);

    snprintf(message, sizeof(message),
             "*** %s disconnected ***\n", username);

    printf("%s", message);
    broadcast_message(message, sock);

    close(sock);
    return NULL;
}

int main(void)
{
    int server_fd, client_fd;
    int opt = 1;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, MAX_CLIENTS) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Chat server running on port %d...\n", PORT);
    printf("Waiting for clients...\n");

    while (1) {
        client_fd = accept(server_fd,
            (struct sockaddr *)&client_addr, &addr_len);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        int *new_sock = malloc(sizeof(int));

        if (new_sock == NULL) {
            close(client_fd);
            continue;
        }

        *new_sock = client_fd;

        pthread_t thread;

        if (pthread_create(&thread, NULL,
                           handle_client, new_sock) != 0) {
            perror("pthread_create");
            close(client_fd);
            free(new_sock);
            continue;
        }

        pthread_detach(thread);
    }

    close(server_fd);
    return 0;
}


