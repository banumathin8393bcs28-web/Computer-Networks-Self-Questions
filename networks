void clear_input(void)
{
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {}
}

int read_student(char *request, size_t size, const char *action)
{
    char reg[30], name[50], dept[30];
    int semester, marks[5];

    printf("Register number (no spaces): ");
    if (scanf("%29s", reg) != 1)
        return 0;

    printf("Student name (no spaces): ");
    if (scanf("%49s", name) != 1)
        return 0;

    printf("Department (no spaces): ");
    if (scanf("%29s", dept) != 1)
        return 0;

    printf("Semester (1-8): ");
    if (scanf("%d", &semester) != 1)
        return 0;

    printf("Enter marks for 5 subjects (0-100): ");

    for (int i = 0; i < 5; i++) {
        if (scanf("%d", &marks[i]) != 1)
            return 0;
    }

    clear_input();

    int len = snprintf(request, size,
        "%s|%s|%s|%s|%d|%d|%d|%d|%d|%d",
        action, reg, name, dept, semester,
        marks[0], marks[1], marks[2], marks[3], marks[4]);

    return len >= 0 && (size_t)len < size;
}

int main(void)
{
    int sock;
    struct sockaddr_in server_addr;
    char request[SIZE];
    char response[SIZE];
    int choice;

    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0) {
        perror("socket");
        return 1;
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0) {
        perror("connect");
        close(sock);
        return 1;
    }

    printf("Connected to Student Result Management Server.\n");

    while (1) {
        printf("\n===== STUDENT RESULT MANAGEMENT =====\n");
        printf("1. Add student\n");
        printf("2. Display all students\n");
        printf("3. Update student\n");
        printf("4. Delete student\n");
        printf("5. Display class topper\n");
        printf("6. Exit\n");
        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            clear_input();
            printf("Invalid choice.\n");
            continue;
        }

        clear_input();

        switch (choice) {
        case 1:
            if (!read_student(request, sizeof(request), "ADD")) {
                printf("Invalid input.\n");
                continue;
            }
            break;

        case 2:
            strcpy(request, "LIST");
            break;

        case 3:
            if (!read_student(request, sizeof(request), "UPDATE")) {
                printf("Invalid input.\n");
                continue;
            }
            break;

        case 4: {
            char reg[30];

            printf("Enter register number to delete: ");

            if (scanf("%29s", reg) != 1) {
                clear_input();
                continue;
            }

            clear_input();

            snprintf(request, sizeof(request),
                     "DELETE|%s", reg);
            break;
        }

        case 5:
            strcpy(request, "TOPPER");
            break;

        case 6:
            strcpy(request, "EXIT");
            send_line(sock, request);

            if (recv_line(sock, response, sizeof(response)))
                printf("%s\n", response);

            close(sock);
            return 0;

        default:
            printf("Invalid choice. Select 1-6.\n");
            continue;
        }

        if (send_line(sock, request) < 0) {
            printf("Failed to send request.\n");
            break;
        }

        do {
            if (!recv_line(sock, response, sizeof(response))) {
                printf("Server disconnected.\n");
                close(sock);
                return 1;
            }

            if (strcmp(response, "END") == 0)
                break;

            printf("%s\n", response);

        } while (strcmp(request, "LIST") == 0);
    }

    close(sock);
    return 0;
}

