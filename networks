#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8088
#define SIZE 1024

int main(void)
{
    int server_fd, client_fd, opt = 1;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    char buffer[SIZE];

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, 5) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Palindrome server running on port %d\n", PORT);
    printf("Waiting for client...\n");

    while (1) {
        client_fd = accept(server_fd,
            (struct sockaddr *)&client_addr, &addr_len);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        printf("Client connected.\n");

        while (1) {
            size_t i = 0;
            char ch;

            while (i < SIZE - 1) {
                ssize_t n = recv(client_fd, &ch, 1, 0);

                if (n <= 0)
                    break;

                if (ch == '\n')
                    break;

                if (ch != '\r')
                    buffer[i++] = ch;
            }

            if (i == 0)
                break;

            buffer[i] = '\0';

            if (strcmp(buffer, "exit") == 0) {
                send(client_fd, "Goodbye\n", 8, 0);
                break;
            }

            int left = 0;
            int right = (int)strlen(buffer) - 1;
            int palindrome = 1;

            while (left < right) {
                if (buffer[left] != buffer[right]) {
                    palindrome = 0;
                    break;
                }

                left++;
                right--;
            }

            if (palindrome)
                send(client_fd, "Palindrome\n", 11, 0);
            else
                send(client_fd, "Not a palindrome\n", 17, 0);

            printf("Input: %s | Result: %s\n",
                   buffer,
                   palindrome ? "Palindrome" : "Not a palindrome");
        }

        close(client_fd);
        printf("Client disconnected.\n");
    }

    close(server_fd);
    return 0;
}

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8088
#define SIZE 1024

int main(void)
{
    int sock;
    struct sockaddr_in server_addr;
    char buffer[SIZE];

    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0) {
        perror("socket");
        return 1;
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server_addr.sin_addr);

    if (connect(sock, (struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0) {
        perror("connect");
        close(sock);
        return 1;
    }

    printf("Connected to palindrome server.\n");
    printf("Enter 'exit' to quit.\n");

    while (1) {
        printf("\nEnter a string: ");

        if (fgets(buffer, sizeof(buffer), stdin) == NULL)
            break;

        buffer[strcspn(buffer, "\r\n")] = '\0';

        char message[SIZE];
        snprintf(message, sizeof(message), "%.1022s\n", buffer);

        if (send(sock, message, strlen(message), 0) < 0)
            break;

        size_t i = 0;
        char ch;

        while (i < SIZE - 1) {
            ssize_t n = recv(sock, &ch, 1, 0);

            if (n <= 0)
                break;

            if (ch == '\n')
                break;

            message[i++] = ch;
        }

        if (i == 0)
            break;

        message[i] = '\0';
        printf("Server response: %s\n", message);

        if (strcmp(buffer, "exit") == 0)
            break;
    }

    close(sock);
    return 0;
}

#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <time.h>

#define PORT 8089
#define MAX 200
#define SIZE 4096
#define FILE_NAME "students.txt"
#define LOG_NAME "student_log.txt"
#define SUBJECTS 5

typedef struct {
    char reg[30];
    char name[50];
    char dept[30];
    int semester;
    int marks[SUBJECTS];
    int total;
    float cgpa;
    char grade[5];
} Student;

Student students[MAX];
int count = 0;

int send_line(int sock, const char *msg)
{
    char output[SIZE];
    int len = snprintf(output, sizeof(output), "%s\n", msg);

    if (len < 0 || len >= SIZE)
        return -1;

    int sent = 0;

    while (sent < len) {
        ssize_t n = send(sock, output + sent, len - sent, 0);
        if (n <= 0)
            return -1;
        sent += n;
    }

    return 0;
}

int recv_line(int sock, char *buffer, size_t size)
{
    size_t i = 0;
    char ch;

    while (i < size - 1) {
        ssize_t n = recv(sock, &ch, 1, 0);

        if (n <= 0)
            return 0;

        if (ch == '\n')
            break;

        if (ch != '\r')
            buffer[i++] = ch;
    }

    buffer[i] = '\0';
    return 1;
}

void log_activity(const char *action)
{
    FILE *fp = fopen(LOG_NAME, "a");
    time_t now = time(NULL);
    struct tm tm_info;
    char timestamp[30];

    localtime_r(&now, &tm_info);
    strftime(timestamp, sizeof(timestamp),
             "%Y-%m-%d %H:%M:%S", &tm_info);

    printf("[%s] %s\n", timestamp, action);

    if (fp != NULL) {
        fprintf(fp, "[%s] %s\n", timestamp, action);
        fclose(fp);
    }
}

void calculate(Student *s)
{
    s->total = 0;

    for (int i = 0; i < SUBJECTS; i++)
        s->total += s->marks[i];

    float average = (float)s->total / SUBJECTS;
    s->cgpa = average / 10.0f;

    if (average >= 90)
        strcpy(s->grade, "O");
    else if (average >= 80)
        strcpy(s->grade, "A+");
    else if (average >= 70)
        strcpy(s->grade, "A");
    else if (average >= 60)
        strcpy(s->grade, "B+");
    else if (average >= 50)
        strcpy(s->grade, "B");
    else
        strcpy(s->grade, "F");
}

int find_student(const char *reg)
{
    for (int i = 0; i < count; i++) {
        if (strcmp(students[i].reg, reg) == 0)
            return i;
    }

    return -1;
}

void load_records(void)
{
    FILE *fp = fopen(FILE_NAME, "r");

    if (fp == NULL)
        return;

    char line[512];

    while (fgets(line, sizeof(line), fp) != NULL &&
           count < MAX) {
        Student s = {0};

        int fields = sscanf(line,
            "%29[^|]|%49[^|]|%29[^|]|%d|%d|%d|%d|%d",
            s.reg, s.name, s.dept, &s.semester,
            &s.marks[0], &s.marks[1],
            &s.marks[2], &s.marks[3]);

        /*
           The fifth mark is read separately below.
           The saved format contains all five marks.
        */
        if (fields != 8)
            continue;

        char *last = strrchr(line, '|');

        if (last == NULL)
            continue;

        if (sscanf(last + 1, "%d", &s.marks[4]) != 1)
            continue;

        calculate(&s);

        if (find_student(s.reg) == -1)
            students[count++] = s;
    }

    fclose(fp);
}

int save_records(void)
{
    FILE *fp = fopen(FILE_NAME, "w");

    if (fp == NULL)
        return 0;

    for (int i = 0; i < count; i++) {
        Student *s = &students[i];

        fprintf(fp, "%s|%s|%s|%d|%d|%d|%d|%d|%d\n",
            s->reg, s->name, s->dept, s->semester,
            s->marks[0], s->marks[1], s->marks[2],
            s->marks[3], s->marks[4]);
    }

    fclose(fp);
    return 1;
}

int valid_student(const Student *s)
{
    if (strlen(s->reg) == 0 ||
        strlen(s->name) == 0 ||
        strlen(s->dept) == 0)
        return 0;

    if (s->semester < 1 || s->semester > 8)
        return 0;

    for (int i = 0; i < SUBJECTS; i++) {
        if (s->marks[i] < 0 || s->marks[i] > 100)
            return 0;
    }

    return 1;
}

int parse_student(char *request, Student *s)
{
    char *saveptr;
    char *token = strtok_r(request, "|", &saveptr);
    int field = 0;

    memset(s, 0, sizeof(*s));

    while (token != NULL) {
        switch (field) {
        case 1:
            snprintf(s->reg, sizeof(s->reg), "%s", token);
            break;
        case 2:
            snprintf(s->name, sizeof(s->name), "%s", token);
            break;
        case 3:
            snprintf(s->dept, sizeof(s->dept), "%s", token);
            break;
        case 4:
            s->semester = atoi(token);
            break;
        case 5:
        case 6:
        case 7:
        case 8:
        case 9:
            s->marks[field - 5] = atoi(token);
            break;
        }

        field++;
        token = strtok_r(NULL, "|", &saveptr);
    }

    if (field != 10 || !valid_student(s))
        return 0;

    calculate(s);
    return 1;
}

void process_request(int sock, char *request)
{
    char response[SIZE];
    char action[20] = "";
    char reg[30] = "";

    if (sscanf(request, "%19[^|]", action) != 1) {
        send_line(sock, "ERROR: Invalid request.");
        return;
    }

    if (strcmp(action, "ADD") == 0 ||
        strcmp(action, "UPDATE") == 0) {

        Student s;

        if (!parse_student(request, &s)) {
            send_line(sock,
                "ERROR: Invalid data. Use valid fields and marks 0-100.");
            return;
        }

        int index = find_student(s.reg);

        if (strcmp(action, "ADD") == 0) {
            if (index != -1) {
                send_line(sock, "ERROR: Register number already exists.");
                return;
            }

            if (count >= MAX) {
                send_line(sock, "ERROR: Student storage is full.");
                return;
            }

            students[count++] = s;
        } else {
            if (index == -1) {
                send_line(sock, "ERROR: Student not found.");
                return;
            }

            students[index] = s;
        }

        if (!save_records()) {
            send_line(sock, "ERROR: Cannot save student file.");
            return;
        }

        snprintf(response, sizeof(response),
                 "SUCCESS: %s completed. Total=%d Grade=%s CGPA=%.2f",
                 action, s.total, s.grade, s.cgpa);
        send_line(sock, response);

        snprintf(response, sizeof(response),
                 "%s student %s (%s)", action, s.name, s.reg);
        log_activity(response);
    }
    else if (strcmp(action, "LIST") == 0) {
        if (count == 0) {
            send_line(sock, "No student records found.");
            return;
        }

        for (int i = 0; i < count; i++) {
            Student *s = &students[i];

            snprintf(response, sizeof(response),
                "Reg=%s Name=%s Dept=%s Sem=%d Marks=%d,%d,%d,%d,%d Total=%d Grade=%s CGPA=%.2f",
                s->reg, s->name, s->dept, s->semester,
                s->marks[0], s->marks[1], s->marks[2],
                s->marks[3], s->marks[4],
                s->total, s->grade, s->cgpa);

            if (send_line(sock, response) < 0)
                return;
        }

        send_line(sock, "END");
        log_activity("Displayed all student records");
    }
    else if (strcmp(action, "DELETE") == 0) {
        if (sscanf(request, "DELETE|%29s", reg) != 1) {
            send_line(sock, "ERROR: Use DELETE|register_number");
            return;
        }

        int index = find_student(reg);

        if (index == -1) {
            send_line(sock, "ERROR: Student not found.");
            return;
        }

        for (int i = index; i < count - 1; i++)
            students[i] = students[i + 1];

        count--;

        if (!save_records()) {
            send_line(sock, "ERROR: Cannot save student file.");
            return;
        }

        send_line(sock, "SUCCESS: Student deleted.");
        log_activity("Deleted student record");
    }
    else if (strcmp(action, "TOPPER") == 0) {
        if (count == 0) {
            send_line(sock, "No student records found.");
            return;
        }

        int best = 0;

        for (int i = 1; i < count; i++) {
            if (students[i].total > students[best].total)
                best = i;
        }

        Student *s = &students[best];

        snprintf(response, sizeof(response),
            "CLASS TOPPER: Reg=%s Name=%s Total=%d/500 Grade=%s CGPA=%.2f",
            s->reg, s->name, s->total, s->grade, s->cgpa);

        send_line(sock, response);
        log_activity("Class topper requested");
    }
    else if (strcmp(action, "EXIT") == 0) {
        send_line(sock, "Goodbye.");
    }
    else {
        send_line(sock, "ERROR: Invalid operation.");
    }
}

void *handle_client(void *arg)
{
    int sock = *(int *)arg;
    free(arg);

    char request[SIZE];

    while (recv_line(sock, request, sizeof(request))) {
        if (strcmp(request, "EXIT") == 0) {
            send_line(sock, "Goodbye.");
            break;
        }

        process_request(sock, request);
    }

    close(sock);
    return NULL;
}

int main(void)
{
    int server_fd, client_fd, opt = 1;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);

    load_records();

    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR,
               &opt, sizeof(opt));

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(server_fd, (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    if (listen(server_fd, 10) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("Student Result Server running on port %d\n", PORT);
    printf("Loaded %d student records from %s\n", count, FILE_NAME);

    while (1) {
        client_fd = accept(server_fd,
            (struct sockaddr *)&client_addr, &addr_len);

        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        int *arg = malloc(sizeof(int));

        if (arg == NULL) {
            close(client_fd);
            continue;
        }

        *arg = client_fd;
        pthread_t thread;

        if (pthread_create(&thread, NULL,
                           handle_client, arg) != 0) {
            perror("pthread_create");
            close(client_fd);
            free(arg);
            continue;
        }

        pthread_detach(thread);
    }

    close(server_fd);
    return 0;
}

